NODE_ENV=development
AUTH_PROVIDER=legacy
# Enable firebase only after migration approval and administrator verification.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_WEB_API_KEY=
HOST=127.0.0.1
PORT=3002
DATABASE_URL=postgresql://chtaw:chtaw_local_dev@127.0.0.1:5434/chtaw?schema=public
# Neon: pooled URL above, direct SSL URL here for LISTEN and migrations.
# Leave unset locally; do not set to an empty string.
# DATABASE_DIRECT_URL=postgresql://...
POSTGRES_PASSWORD=chtaw_local_dev
CORS_ORIGINS=http://127.0.0.1:3001,http://localhost:3001
REFRESH_COOKIE_SAMESITE=lax
# Generate two DIFFERENT random secrets: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TTL_SECONDS=900
REFRESH_TTL_SECONDS=604800
UPLOAD_DIR=./uploads
MEDIA_STORAGE=local
# Render: MEDIA_STORAGE=postgres persists private images in Neon (100 MiB quota).
MEDIA_MAX_TOTAL_BYTES=104857600
UPLOAD_MAX_BYTES=5242880
SWAGGER_ENABLED=true
# Set only when explicitly running the first-admin seed. Never committed.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_FIRST_NAME=Admin
SEED_ADMIN_LAST_NAME=Chtaw
# Integration tests require a DEDICATED test database (name ends with _test).
TEST_DATABASE_URL=postgresql://chtaw:chtaw_local_dev@127.0.0.1:5434/chtaw_test

# Web Push is disabled when all three VAPID values are empty.
# Generate once on the server: npx web-push generate-vapid-keys
# Keep the private key on the backend only. Use a real operator contact.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
NOTIFICATION_TIMEZONE=Africa/Tunis
# Optional exact HTTPS push-service origins, comma-separated. Trusted vendors are built in.
PUSH_ALLOWED_ORIGINS=
