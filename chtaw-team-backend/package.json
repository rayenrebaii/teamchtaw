{
  "name": "chtaw-team-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node --watch --require ts-node/register/transpile-only src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test prisma/seed.ts",
    "test": "node scripts/safe-command.mjs backend:test",
    "test:integration": "node scripts/run-isolated-tests.mjs",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "test:isolated": "node scripts/run-isolated-tests.mjs",
    "test:frontend:isolated": "node scripts/run-isolated-tests.mjs --frontend",
    "test:firebase": "node scripts/run-isolated-tests.mjs --firebase",
    "test:migration": "node scripts/run-isolated-tests.mjs --migration",
    "test:safety": "node --test scripts/test-safety.test.cjs",
    "build:local": "node scripts/safe-command.mjs backend:build"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-express": "^11.2.8",
    "@nestjs/platform-socket.io": "^11.0.0",
    "@nestjs/swagger": "^11.4.8",
    "@nestjs/throttler": "^6.0.0",
    "@nestjs/websockets": "^11.0.0",
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "argon2": "^0.44.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "dotenv": "^17.0.0",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.0.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.0.0",
    "@types/supertest": "^6.0.0",
    "@types/web-push": "^3.6.4",
    "eslint": "^9.0.0",
    "jest": "^30.0.0",
    "prisma": "^7.0.0",
    "socket.io-client": "^4.8.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.0.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.0.0"
  },
  "overrides": {
    "multer": "^2.5.0",
    "rimraf": {
      "glob": "^14.0.2"
    }
  }
}
